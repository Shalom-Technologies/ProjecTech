# Copy to .env for local development. On Fly.io set these with:  fly secrets set NAME=value
# Never commit the real .env file.

MONGODB_URL=mongodb+srv://USER:PASSWORD@cluster.example.mongodb.net
DATABASE_NAME=marketplace_db

# REQUIRED. At least 32 random characters. Generate with:  openssl rand -hex 32
# Changing it later logs every user out.
SECRET_KEY=

# The website addresses allowed to call the API (comma separated, no trailing slash).
CORS_ORIGINS=http://localhost:5173
# Where the website lives; used in emails, invoice links and the Paystack return page.
FRONTEND_URL=http://localhost:5173

PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
EMAIL_FROM=
# Where alerts go: problem reports, payments to refund, failed refunds, emails that did not send.
ADMIN_EMAIL=

# Optional, shown with their defaults
# CURRENCY=KES
# REVIEW_WINDOW_DAYS=7
# PAYOUT_HOLD_DAYS=7
